{
  "$defs": {
    "Compatibility": {
      "additionalProperties": false,
      "properties": {
        "backend_modes": {
          "items": {
            "enum": [
              "static",
              "fastapi"
            ],
            "type": "string"
          },
          "title": "Backend Modes",
          "type": "array"
        },
        "fixtures": {
          "items": {
            "type": "string"
          },
          "title": "Fixtures",
          "type": "array"
        },
        "history_states": {
          "items": {
            "enum": [
              "current",
              "historical"
            ],
            "type": "string"
          },
          "title": "History States",
          "type": "array"
        },
        "publish_states": {
          "items": {
            "enum": [
              "published",
              "unpublished"
            ],
            "type": "string"
          },
          "title": "Publish States",
          "type": "array"
        },
        "source_formats": {
          "items": {
            "enum": [
              "single-file",
              "multi-file"
            ],
            "type": "string"
          },
          "title": "Source Formats",
          "type": "array"
        }
      },
      "required": [
        "source_formats",
        "backend_modes",
        "publish_states",
        "history_states",
        "fixtures"
      ],
      "title": "Compatibility",
      "type": "object"
    },
    "EnvironmentMetadata": {
      "additionalProperties": false,
      "properties": {
        "machine": {
          "minLength": 1,
          "title": "Machine",
          "type": "string"
        },
        "node_version": {
          "minLength": 1,
          "title": "Node Version",
          "type": "string"
        },
        "python_version": {
          "minLength": 1,
          "title": "Python Version",
          "type": "string"
        },
        "system": {
          "minLength": 1,
          "title": "System",
          "type": "string"
        }
      },
      "required": [
        "python_version",
        "node_version",
        "system",
        "machine"
      ],
      "title": "EnvironmentMetadata",
      "type": "object"
    },
    "FeatureFlags": {
      "additionalProperties": false,
      "properties": {
        "acceptance_gate_v1": {
          "title": "Acceptance Gate V1",
          "type": "boolean"
        },
        "appspec_v1": {
          "title": "Appspec V1",
          "type": "boolean"
        },
        "durable_jobs_v1": {
          "title": "Durable Jobs V1",
          "type": "boolean"
        },
        "sandbox_v1": {
          "title": "Sandbox V1",
          "type": "boolean"
        },
        "specialist_workers_v1": {
          "title": "Specialist Workers V1",
          "type": "boolean"
        }
      },
      "required": [
        "durable_jobs_v1",
        "appspec_v1",
        "acceptance_gate_v1",
        "specialist_workers_v1",
        "sandbox_v1"
      ],
      "title": "FeatureFlags",
      "type": "object"
    },
    "GenerationQuality": {
      "additionalProperties": false,
      "properties": {
        "case_success": {
          "$ref": "#/$defs/QualityMetric"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/QualityCase"
          },
          "title": "Cases",
          "type": "array"
        },
        "deterministic_hash_reuse": {
          "$ref": "#/$defs/QualityMetric"
        },
        "first_pass_proposal_validity": {
          "$ref": "#/$defs/QualityMetric"
        },
        "production_build_success": {
          "$ref": "#/$defs/QualityMetric"
        },
        "publish_gate_decisions": {
          "$ref": "#/$defs/QualityMetric"
        },
        "repair_invocation": {
          "$ref": "#/$defs/QualityMetric"
        },
        "repair_success": {
          "$ref": "#/$defs/QualityMetric"
        },
        "runtime_health": {
          "$ref": "#/$defs/QualityMetric"
        },
        "schema_version": {
          "default": "1.0",
          "pattern": "^1\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "source_import_validity": {
          "$ref": "#/$defs/QualityMetric"
        },
        "verification_success": {
          "$ref": "#/$defs/QualityMetric"
        }
      },
      "required": [
        "case_success",
        "first_pass_proposal_validity",
        "repair_invocation",
        "repair_success",
        "source_import_validity",
        "production_build_success",
        "runtime_health",
        "verification_success",
        "publish_gate_decisions",
        "deterministic_hash_reuse",
        "cases"
      ],
      "title": "GenerationQuality",
      "type": "object"
    },
    "QualityCase": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "minLength": 1,
          "title": "Actual",
          "type": "string"
        },
        "category": {
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "expected": {
          "minLength": 1,
          "title": "Expected",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "category",
        "passed",
        "expected",
        "actual"
      ],
      "title": "QualityCase",
      "type": "object"
    },
    "QualityMetric": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "minimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "numerator": {
          "minimum": 0,
          "title": "Numerator",
          "type": "integer"
        },
        "rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "QualityMetric",
      "type": "object"
    },
    "SuiteResult": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "passed": {
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "passed",
        "failed",
        "duration_ms"
      ],
      "title": "SuiteResult",
      "type": "object"
    },
    "SuiteResults": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "$ref": "#/$defs/SuiteResult"
        },
        "browser": {
          "$ref": "#/$defs/SuiteResult"
        },
        "frontend_unit": {
          "$ref": "#/$defs/SuiteResult"
        },
        "provider_smoke": {
          "$ref": "#/$defs/SuiteResult"
        }
      },
      "required": [
        "backend",
        "frontend_unit",
        "browser",
        "provider_smoke"
      ],
      "title": "SuiteResults",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Current capture contract with deterministic generation-quality evidence.",
  "properties": {
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "compatibility": {
      "$ref": "#/$defs/Compatibility"
    },
    "dirty_tree": {
      "title": "Dirty Tree",
      "type": "boolean"
    },
    "environment": {
      "$ref": "#/$defs/EnvironmentMetadata"
    },
    "feature_flags": {
      "$ref": "#/$defs/FeatureFlags"
    },
    "fixture_pack_version": {
      "minLength": 1,
      "title": "Fixture Pack Version",
      "type": "string"
    },
    "generation": {
      "$ref": "#/$defs/GenerationQuality"
    },
    "schema_version": {
      "const": "1.2",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "source_revision": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Source Revision",
      "type": "string"
    },
    "suites": {
      "$ref": "#/$defs/SuiteResults"
    }
  },
  "required": [
    "captured_at",
    "source",
    "suites",
    "compatibility",
    "schema_version",
    "source_revision",
    "dirty_tree",
    "feature_flags",
    "environment",
    "fixture_pack_version",
    "generation"
  ],
  "title": "BaselineReport",
  "type": "object"
}
