    "index.html": "<!doctype html><html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Community Operations With A Deliberately Long Product Name</title><style>\n:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;color:#17251f;background:#f3f6f4;font-synthesis:none;--ink:#17251f;--muted:#637269;--paper:#f3f6f4;--surface:#fff;--line:#dce4de;--accent:#245d49;--accent-hover:#194a39;--accent-soft:#e6f0ea;--danger:#a23b32;--danger-soft:#fff0ed;--success:#286247;--success-soft:#eaf5ed;--shadow:0 16px 45px rgba(28,52,39,.06)}\n*{box-sizing:border-box}\n[hidden]{display:none!important}\nbody{margin:0;min-width:320px;background:var(--paper)}\nbutton,input,textarea{font:inherit}\nbutton{min-height:42px;cursor:pointer;border:0;border-radius:11px;padding:10px 16px;font-weight:700;transition:background .16s ease,border-color .16s ease}\nbutton:disabled{cursor:not-allowed;opacity:.5}\nbutton:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #8ebc9f;outline-offset:2px}\nbutton.primary{background:var(--accent);color:#fff}\nbutton.primary:hover:not(:disabled){background:var(--accent-hover)}\nbutton.secondary{background:#fff;color:var(--ink);border:1px solid var(--line)}\nbutton.secondary:hover:not(:disabled){border-color:#aabbb0;background:#fafcfb}\n.app{max-width:1180px;margin:0 auto;padding:30px 32px 48px}\nnav{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:38px}\n.brand{display:flex;align-items:center;gap:11px;min-width:0;font-size:19px;font-weight:800;letter-spacing:-.025em;overflow-wrap:anywhere}\n.brand-mark{display:grid;place-items:center;flex:0 0 34px;width:34px;height:34px;border-radius:11px;background:var(--ink);color:#d8eadf}\n.status{display:inline-flex;align-items:center;gap:8px;flex:none;color:var(--muted);font-size:12px;font-weight:650}\n.status-dot{width:8px;height:8px;border-radius:50%;background:#c18a3b}\n.status.online .status-dot{background:#3a9267}\n.status.offline .status-dot{background:var(--danger)}\n.hero{display:grid;grid-template-columns:minmax(0,1fr) 250px;gap:34px;align-items:end;margin-bottom:28px}\n.hero-copy{min-width:0}\n.eyebrow{margin:0 0 10px;color:var(--accent);font-size:11px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}\n.hero h1{max-width:820px;margin:0;font-size:clamp(36px,5vw,58px);line-height:1.06;letter-spacing:-.045em;overflow-wrap:anywhere}\n.hero-workflow{max-width:740px;margin:18px 0 0;color:var(--muted);font-size:16px;line-height:1.7;white-space:pre-line;overflow-wrap:anywhere}\n.metric{min-width:0;padding:23px;border:1px solid #cfded3;border-radius:19px;background:var(--accent-soft)}\n.metric-label{display:block;color:var(--accent);font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}\n.metric strong{display:block;margin:15px 0 4px;font-size:38px;line-height:1;letter-spacing:-.04em}\n.metric small{color:var(--muted);overflow-wrap:anywhere}\n.alert{display:flex;align-items:flex-start;gap:10px;margin:0 0 18px;padding:13px 15px;border-radius:12px;font-size:14px;line-height:1.5;overflow-wrap:anywhere}\n.alert.error{border:1px solid #efc8bf;background:var(--danger-soft);color:var(--danger)}\n.alert.success{border:1px solid #c9e2d0;background:var(--success-soft);color:var(--success)}\n.workspace{display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:20px;align-items:start}\n.panel{min-width:0;padding:24px;border:1px solid var(--line);border-radius:20px;background:var(--surface);box-shadow:var(--shadow)}\n.panel-header{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:22px}\n.panel-header h2,.context-panel h2{margin:0;font-size:20px;letter-spacing:-.025em;overflow-wrap:anywhere}\n.count-badge{flex:none;padding:6px 10px;border-radius:999px;background:#f0f4f1;color:var(--muted);font-size:12px;font-weight:700}\n.record-form{margin:0 0 25px;padding-bottom:25px;border-bottom:1px solid var(--line)}\n.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}\n.field{display:flex;flex-direction:column;gap:7px;min-width:0;color:var(--ink);font-size:13px;font-weight:650}\n.field-wide{grid-column:1/-1}\n.field-label{display:flex;align-items:baseline;justify-content:space-between;gap:10px}\n.field-note{color:var(--muted);font-size:11px;font-weight:500}\n.field input:not([type=checkbox]),.field textarea{width:100%;min-width:0;min-height:44px;padding:11px 12px;border:1px solid #cfd9d2;border-radius:10px;background:#fbfcfb;color:var(--ink);line-height:1.45}\n.field textarea{min-height:96px;resize:vertical}\n.field input::placeholder,.field textarea::placeholder{color:#8b978f}\n.field input:disabled,.field textarea:disabled{background:#f0f2f0;color:#879188}\n.field-checkbox{display:grid;grid-template-columns:20px minmax(0,1fr);align-items:center;gap:10px;min-height:44px;padding:10px 12px;border:1px solid #cfd9d2;border-radius:10px;background:#fbfcfb}\n.field-checkbox input{width:18px;height:18px;margin:0;accent-color:var(--accent)}\n.form-actions{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-top:18px}\n.form-actions small{color:var(--muted);line-height:1.5}\n.items{display:grid;gap:12px}\n.item{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:16px;align-items:start;padding:17px;border:1px solid var(--line);border-radius:14px;background:#fcfdfc}\n.item-content{min-width:0}\n.item-title{display:block;margin-bottom:12px;font-size:16px;line-height:1.4;overflow-wrap:anywhere}\n.item-fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(135px,1fr));gap:10px 16px}\n.item-field{display:flex;flex-direction:column;gap:3px;min-width:0;color:var(--muted);font-size:12px;line-height:1.45;overflow-wrap:anywhere}\n.item-field b{color:#4c5d52;font-size:10px;font-weight:800;letter-spacing:.05em;text-transform:uppercase}\n.item-actions{display:flex;gap:7px}\n.icon-button{min-width:36px;min-height:36px;padding:7px 10px;border:1px solid var(--line);background:#fff;color:var(--muted)}\n.icon-button.delete:hover:not(:disabled){border-color:#e4b5ac;background:var(--danger-soft);color:var(--danger)}\n.context-panel{box-shadow:none}\n.context-panel p:not(.eyebrow){color:var(--muted);font-size:14px;line-height:1.7;white-space:pre-line;overflow-wrap:anywhere}\n.context-panel button{width:100%;margin-top:10px}\n.context-note{display:block;margin-top:15px;color:var(--muted);font-size:12px;line-height:1.6}\n.empty-state{padding:32px 22px;border:1px dashed #bdccc1;border-radius:14px;background:#fafcfa;text-align:center}\n.empty-state strong{display:block;margin-bottom:7px;font-size:15px;overflow-wrap:anywhere}\n.empty-state p{max-width:420px;margin:0 auto;color:var(--muted);font-size:13px;line-height:1.6;overflow-wrap:anywhere}\n.loading-state{color:var(--muted)}\n@media(max-width:860px){.hero,.workspace{grid-template-columns:minmax(0,1fr)}.metric{max-width:none}.context-panel button{width:auto}.hero{gap:20px}}\n@media(max-width:600px){.app{padding:20px 16px 32px}nav{align-items:flex-start;margin-bottom:30px}.brand{font-size:17px}.status{font-size:11px}.hero h1{font-size:36px}.hero-workflow{font-size:15px}.panel{padding:18px;border-radius:16px}.form-grid{grid-template-columns:minmax(0,1fr)}.field-wide{grid-column:auto}.panel-header{align-items:center}.form-actions{align-items:stretch;flex-direction:column}.form-actions button{width:100%}.item{grid-template-columns:minmax(0,1fr)}.item-actions{justify-content:flex-end}.item-fields{grid-template-columns:minmax(0,1fr)}}\n@media(prefers-reduced-motion:reduce){button{transition:none}}\n</style></head><body><main class=\"app\"><nav aria-label=\"Application\"><div class=\"brand\"><span class=\"brand-mark\" aria-hidden=\"true\">✦</span><span>Community Operations With A Deliberately Long Product Name</span></div><span id=\"connection\" class=\"status\"><i class=\"status-dot\" aria-hidden=\"true\"></i><span id=\"status-text\">Connecting…</span></span></nav><header class=\"hero\"><div class=\"hero-copy\"><p class=\"eyebrow\">Gatherings</p><h1>Bring the community together</h1><p class=\"hero-workflow\">A registered member reviews upcoming community operations, filters them by date, opens an operation to inspect its details, and records attendance while seeing useful validation and confirmation feedback throughout the complete primary workflow.</p></div><aside class=\"metric\"><span class=\"metric-label\">Overview</span><strong id=\"count\">0</strong><small id=\"metric-label\">0 gatherings</small></aside></header><div id=\"error\" class=\"alert error\" role=\"alert\" hidden></div><div id=\"notice\" class=\"alert success\" role=\"status\" hidden></div><section class=\"workspace\"><article class=\"panel\"><header class=\"panel-header\"><div><p class=\"eyebrow\">Workspace</p><h2>Gatherings</h2></div><span id=\"count-badge\" class=\"count-badge\">0 gatherings</span></header><form class=\"record-form\" id=\"create-form\"><div class=\"form-grid\"><label class=\"field\"><span class=\"field-label\"><span>Title</span><span class=\"field-note\">Required</span></span><input name=\"title\" type=\"text\" required></label><label class=\"field field-wide\"><span class=\"field-label\"><span>Details</span><span class=\"field-note\">Optional</span></span><textarea name=\"details\"></textarea></label><label class=\"field\"><span class=\"field-label\"><span>Attendee count</span><span class=\"field-note\">Required</span></span><input name=\"attendee_count\" type=\"number\" required></label><label class=\"field\"><span class=\"field-label\"><span>Rating</span><span class=\"field-note\">Optional</span></span><input name=\"rating\" type=\"number\"></label><label class=\"field\"><span class=\"field-label\"><span>Published</span><span class=\"field-note\">Required</span></span><input name=\"published\" type=\"checkbox\"></label><label class=\"field\"><span class=\"field-label\"><span>Available on</span><span class=\"field-note\">Required</span></span><input name=\"available_on\" type=\"date\" required></label><label class=\"field\"><span class=\"field-label\"><span>Created at</span><span class=\"field-note\">Required</span></span><input name=\"created_at\" type=\"datetime-local\" required></label><label class=\"field\"><span class=\"field-label\"><span>External id</span><span class=\"field-note\">Optional</span></span><input name=\"external_id\" type=\"text\"></label></div><div class=\"form-actions\"><small>Complete the required fields to continue.</small><button class=\"primary\" id=\"create-button\" >Add a gathering</button></div></form><div class=\"items\" id=\"items\"></div></article><aside class=\"panel context-panel\"><p class=\"eyebrow\">About this workspace</p><h2>Community Operations With A Deliberately Long Product Name</h2><p>Coordinate community operations with clear schedules and reliable attendance records.</p><button class=\"secondary\" id=\"refresh\">Refresh data</button><small class=\"context-note\">Changes are saved to this workspace.</small></aside></section></main><script>\nconst FIELDS = [{\"name\": \"title\", \"label\": \"Title\", \"kind\": \"string\", \"required\": true}, {\"name\": \"details\", \"label\": \"Details\", \"kind\": \"text\", \"required\": false}, {\"name\": \"attendee_count\", \"label\": \"Attendee count\", \"kind\": \"integer\", \"required\": true}, {\"name\": \"rating\", \"label\": \"Rating\", \"kind\": \"number\", \"required\": false}, {\"name\": \"published\", \"label\": \"Published\", \"kind\": \"boolean\", \"required\": true}, {\"name\": \"available_on\", \"label\": \"Available on\", \"kind\": \"date\", \"required\": true}, {\"name\": \"created_at\", \"label\": \"Created at\", \"kind\": \"datetime\", \"required\": true}, {\"name\": \"external_id\", \"label\": \"External id\", \"kind\": \"uuid\", \"required\": false}]\nconst BOOLEAN_FIELD = \"published\"\nconst TITLE_FIELD = \"title\"\nconst CAN_EDIT = true\nconst ENTITY_LABEL = \"gathering\"\nconst ENTITY_PLURAL = \"gatherings\"\nconst CREATE_LABEL = \"Add a gathering\"\nconst DELETE_LABEL = \"Delete gathering\"\nconst EMPTY_TITLE = \"Your calendar is open\"\nconst EMPTY_MESSAGE = \"Add your first gathering to start planning.\"\nconst CREATED_MESSAGE = \"Gathering created.\"\nconst DELETED_MESSAGE = \"Gathering deleted.\"\nconst STORAGE_KEY = \"forma-appspec:Community Operations With A Deliberately Long Product Name:events\"\nconst read = () => JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]')\nconst write = items => localStorage.setItem(STORAGE_KEY, JSON.stringify(items))\nconst listItems = async () => read()\nconst createItem = async values => { const items = read(); const item = { id: Date.now(), ...values }; write([item, ...items]); return item }\nconst updateItem = async (id, values) => { const items = read(); write(items.map(x => x.id === id ? { ...x, ...values } : x)); return { ...read().find(x => x.id === id) } }\nconst deleteItem = async id => { write(read().filter(x => x.id !== id)) }\n\nlet items = [], loading = true, busy = false, online = false, error = '', notice = ''\nconst valuesFrom = form => { const values = {}; FIELDS.forEach(field => { const input = form.elements[field.name]; if (!field.required && input.value === '' && field.kind !== 'boolean') values[field.name] = null; else values[field.name] = field.kind === 'boolean' ? input.checked : ['integer', 'number'].includes(field.kind) ? Number(input.value) : input.value }); return values }\nconst state = (title, message, loadingState = false) => { const node = document.createElement('div'); node.className = loadingState ? 'empty-state loading-state' : 'empty-state'; node.setAttribute('role', 'status'); const heading = document.createElement('strong'); heading.textContent = title; const text = document.createElement('p'); text.textContent = message; node.append(heading, text); return node }\nconst render = () => {\n  const root = document.getElementById('items'), errorNode = document.getElementById('error'), noticeNode = document.getElementById('notice')\n  errorNode.hidden = !error; errorNode.textContent = error\n  noticeNode.hidden = !notice; noticeNode.textContent = notice\n  document.getElementById('count').textContent = items.length\n  document.getElementById('metric-label').textContent = `${items.length} ${ENTITY_PLURAL}`\n  document.getElementById('count-badge').textContent = `${items.length} ${ENTITY_PLURAL}`\n  document.getElementById('connection').className = `status ${loading ? '' : online ? 'online' : 'offline'}`\n  document.getElementById('status-text').textContent = loading ? 'Connecting…' : online ? 'Connected' : 'Offline'\n  const createButton = document.getElementById('create-button'); createButton.disabled = !CAN_EDIT || busy; createButton.textContent = busy ? 'Working…' : CREATE_LABEL\n  document.getElementById('refresh').disabled = busy\n  FIELDS.forEach(field => { document.getElementById('create-form').elements[field.name].disabled = !CAN_EDIT || busy })\n  root.replaceChildren()\n  if (loading) { root.append(state('Loading…', `Loading ${ENTITY_PLURAL}.`, true)); return }\n  if (!items.length) { root.append(state(EMPTY_TITLE, EMPTY_MESSAGE)); return }\n  items.forEach(item => {\n    const row = document.createElement('div'); row.className = 'item'\n    const content = document.createElement('div'); content.className = 'item-content'\n    const title = document.createElement('strong'); title.className = 'item-title'; title.textContent = item[TITLE_FIELD] || `${ENTITY_LABEL} ${item.id}`; content.append(title)\n    const fields = document.createElement('div'); fields.className = 'item-fields'\n    FIELDS.forEach(field => { const text = document.createElement('small'); text.className = 'item-field'; const label = document.createElement('b'); label.textContent = field.label; text.append(label, document.createTextNode(String(item[field.name] ?? '—'))); fields.append(text) })\n    content.append(fields); row.append(content)\n    const actions = document.createElement('div'); actions.className = 'item-actions'\n    if (CAN_EDIT && BOOLEAN_FIELD) { const toggle = document.createElement('button'); toggle.className = 'icon-button'; toggle.textContent = '✓'; toggle.disabled = busy; toggle.setAttribute('aria-label', 'Toggle status'); toggle.onclick = () => run(() => updateItem(item.id, { [BOOLEAN_FIELD]: !item[BOOLEAN_FIELD] }), 'Changes saved.'); actions.append(toggle) }\n    if (CAN_EDIT) { const remove = document.createElement('button'); remove.className = 'icon-button delete'; remove.textContent = '×'; remove.disabled = busy; remove.setAttribute('aria-label', DELETE_LABEL); remove.onclick = () => run(() => deleteItem(item.id), DELETED_MESSAGE); actions.append(remove) }\n    row.append(actions); root.append(row)\n  })\n}\nconst refresh = async () => { loading = true; error = ''; notice = ''; render(); try { items = await listItems(); online = true } catch (reason) { online = false; error = reason.message } finally { loading = false; render() } }\nconst run = async (action, message) => { busy = true; error = ''; notice = ''; render(); try { await action(); await refresh(); notice = message; return true } catch (reason) { error = reason.message; return false } finally { busy = false; render() } }\ndocument.getElementById('create-form').addEventListener('submit', async event => { event.preventDefault(); if (!CAN_EDIT || busy) return; const form = event.currentTarget; if (await run(() => createItem(valuesFrom(form)), CREATED_MESSAGE)) form.reset() })\ndocument.getElementById('refresh').addEventListener('click', refresh)\nrender(); refresh()\n</script></body></html>"
