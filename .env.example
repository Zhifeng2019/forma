# Forma Studio development settings
# Copy this file to .env and replace secrets locally. Never commit .env.

SECRET_KEY=replace-with-a-long-random-secret
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STUDIO_BASE_URL=http://127.0.0.1:8000
ACCESS_TOKEN_DAYS=14

# Generated application runtimes
RUNTIME_PYTHON=
RUNTIME_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
RUNTIME_NPM_REGISTRY=https://registry.npmmirror.com
RUNTIME_BUILD_TIMEOUT=240
RUNTIME_INSTALL_TIMEOUT=240
RUNTIME_START_TIMEOUT=25
RUNTIME_REQUEST_TIMEOUT=20
RUNTIME_MEMORY_MB=768
RUNTIME_IDLE_SECONDS=1800
RUNTIME_MAX_PROCESSES=8

# Optional infrastructure flags; the default studio behavior is used while these are false.
DURABLE_JOBS_V1=false
SANDBOX_V1=false
