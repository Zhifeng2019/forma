# Forma Studio development settings
# Copy this file to backend/.env and replace secrets locally. Never commit .env.
# Keep backend/.env as the only .env file; a repository-root .env is not loaded.

SECRET_KEY=replace-with-a-long-random-secret
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STUDIO_BASE_URL=http://127.0.0.1:8000
# Empty for local root hosting; /forma for https://www.riskcat.cn/forma/.
# Match the frontend build's --base=/forma/; keep STUDIO_BASE_URL as an origin only.
STUDIO_PATH_PREFIX=
APPS_BASE_URL=http://apps.localhost:8000
PREVIEW_TOKEN_MINUTES=15
ACCESS_TOKEN_DAYS=14

# Generated application runtimes
RUNTIME_PYTHON=
RUNTIME_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
RUNTIME_NPM_REGISTRY=https://registry.npmmirror.com
RUNTIME_BUILD_TIMEOUT=240
RUNTIME_INSTALL_TIMEOUT=240
RUNTIME_START_TIMEOUT=25
RUNTIME_REQUEST_TIMEOUT=20
RUNTIME_MEMORY_MB=768
RUNTIME_IDLE_SECONDS=1800
RUNTIME_MAX_PROCESSES=8

# Independent runtime features. Acceptance gates apply only to historical stored contracts.
DURABLE_JOBS_V1=false
ACCEPTANCE_GATE_V1=false
SANDBOX_V1=false

# Registration: both contact verification and administrator approval are required.
# No verification codes are returned by the API or logged. Enable at least one channel.
AUTH_EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS_MODE=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Forma Studio

# Mainland China (+86) SMS via Alibaba Cloud Dysmsapi SendSms.
# Use a RAM key permitted to call SendSms and an approved registration template.
AUTH_SMS_DELIVERY_ENABLED=false
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_REGISTRATION_TEMPLATE_CODE=
# Optional: use a dedicated reset template; otherwise use the configured verification template above.
ALIYUN_SMS_PASSWORD_RESET_TEMPLATE_CODE=
ALIYUN_SMS_CODE_PARAM=code
AUTH_DELIVERY_TRANSPORT_TIMEOUT_SECONDS=15
