# Install only after DNS and a matching wildcard certificate are ready.
# This is a new server, not a replacement for existing application servers.
server {
    listen 80;
    server_name *.forma-apps.example.com;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name *.forma-apps.example.com;
    ssl_certificate /etc/nginx/ssl/forma-apps/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/forma-apps/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Preview URLs contain short-lived grants. Do not retain them in access logs.
    access_log off;

    location / {
        # No URI suffix: preserve /apps/... and /preview/... exactly.
        proxy_pass http://127.0.0.1:8108;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        client_max_body_size 20m;
    }
}
