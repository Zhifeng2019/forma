[Unit]
Description=Forma AI Product Studio
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=forma
Group=forma
WorkingDirectory=/opt/forma/backend
Environment="PATH=/opt/forma/node/bin:/opt/forma/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment=PYTHONUNBUFFERED=1
# Settings are loaded by Python from /opt/forma/backend/.env only.
ExecStart=/opt/forma/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8108 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillMode=control-group
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
